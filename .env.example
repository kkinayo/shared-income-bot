# Telegram bot token from @BotFather
BOT_TOKEN=
# PostgreSQL connection string (local docker compose value below)
DATABASE_URL=postgresql://bot:bot@db:5432/bot
# true for managed Postgres (Neon, Supabase...), false for local
DB_SSL=false
# Comma-separated Telegram user IDs allowed to use the bot (send /id to the bot to see yours).
# Empty = anyone can use it.
ALLOWED_USER_IDS=
# How the balance is split: name:percent, must add up to 100
SPLIT=Общий счёт:40,Накопления:40,Личное:20
CURRENCY=₽
# Set to the public URL to run in webhook mode (Render sets RENDER_EXTERNAL_URL automatically)
WEBHOOK_BASE_URL=
